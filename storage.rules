rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // 관리자(cyber924@naver.com) 여부를 확인하는 함수
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'cyber924@naver.com';
    }

    // 1. 공용 업로드 폴더 (인증된 모든 사용자 허용)
    match /uploads {
      allow read: if request.auth != null;
    }
    match /uploads/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // 2. 사용자별 이미지 폴더
    match /images/{userId} {
      // 폴더 자체에 대한 접근 권한 (listAll 호출 시 필요)
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      
      // 하위 모든 파일 및 경로에 대한 접근 권한
      match /{allPaths=**} {
        allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      }
    }
  }
}